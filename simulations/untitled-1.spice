print v(vg11) v(vg6)
print v(vb1) v(vb2)


write op_operating_point.raw

*==================================================
* 3. DIFFERENTIAL AC GAIN AND PHASE
*==================================================

ac dec 200 1 10G

let vid = v(vip)-v(vin)
let vod = v(vop)-v(von)
let av_diff = vod/vid

let gain_db = db(av_diff)
let phase_deg = cph(av_diff)*180/pi

if phase_deg[0] > 90
    let phase_deg = phase_deg-360
end

plot gain_db phase_deg xlog ylimit -360 80 title Differential

