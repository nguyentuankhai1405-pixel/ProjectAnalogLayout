** sch_path: /foss/designs/BTDay7-Ex/TestCMRR_PSRR-OTA.sch
.subckt TestCMRR_PSRR-OTA

I2 net1 GND 80u
Cload vout1 GND 500f
vdd vdd GND DC 1.2
vp vp GND DC 0.6 AC 1 0
x1 vp vp GND vdd net1 vout1 OTA
I1 net2 GND 80u
C2 vm2 GND 4G
L9 vout2 vm2 4G
x2 vm2 net3 GND VDDac net2 vout2 OTA
v4 net3 GND DC 0.6
v2 VDDac GND DC 1.2 AC 1 0
I0 net4 GND 80u
Cload1 vout GND 500f
C1 vm1 GND 4G
L15 vout vm1 4G
x3 vm1 vp GND vdd net4 vout OTA
**** begin user architecture code

.lib /foss/pdks/ihp-sg13g2/libs.tech/ngspice/models/cornerCAP.lib cap_typ
.lib cornerMOSlv.lib mos_tt




.control
op
save all

* Chay phan tich AC tu 1Hz den 10MHz
ac dec 100 1 10e6
save all

* Tinh toan cac dai luong theo Slide 23
let Av = db(v(vout))
let PSRR = db(v(vout2)/v(VDDac))
let CMRR = db((v(vout)/v(vp))/(v(vout1)/v(vp)))
let phase = 180*cph(vout)/pi

* Ghi du lieu ra file raw
write output_file.raw

* Ve do thi kiem tra truc tiep tren Ngspice
plot CMRR xlog title 'Common-Mode Rejection Ratio - CMRR (dB)'
plot PSRR xlog title 'Power Supply Rejection Ratio - PSRR (dB)'
.endc


**** end user architecture code
.ends

