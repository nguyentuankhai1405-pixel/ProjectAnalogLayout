XM9 VB1 VB1 VDD VDD sg13_lv_pmos w=60u l=5u ng=1 m=1 mm_ok=1
XM10 VON VB1 VDD VDD sg13_lv_pmos w=60u l=5u ng=1 m=2 mm_ok=1
VB2 VBIAS VSS 0.72
**** begin user architecture code


.lib cornerMOSlv.lib mos_tt




.control
op
print von vop
print v(vop)-v(von)
