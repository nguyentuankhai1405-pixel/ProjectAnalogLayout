VIN VIN VSS DC 0.8 Ac -0.5
VIP VIP VSS DC 0.8 Ac +0.5
VSS VSS GND 0
XM4 VOP VB1 VDD VDD sg13_lv_pmos w=60u l=5u ng=1 m=2 mm_ok=1
XM6 VB1 VB2 VSS VSS sg13_lv_nmos w=12u l=2u ng=1 m=1 mm_ok=1
XM7 VB2 VB2 VSS VSS sg13_lv_nmos w=12u l=2u ng=1 m=1 mm_ok=1
